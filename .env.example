# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run preview`.
# In production, set the secret values with `npx wrangler secret put <NAME>`.

# Public URL of the portal (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The email of Naav's admin account (used for the first-run bootstrap check)
ADMIN_EMAIL=

# Random secret for signing guest cookies, OAuth state and peppering PIN hashes.
# Generate: openssl rand -base64 48
APP_SECRET=

# 32-byte key (base64) for encrypting the Google refresh token at rest.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Authorised redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
